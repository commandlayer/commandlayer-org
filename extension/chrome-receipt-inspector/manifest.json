{
  "manifest_version": 3,
  "name": "VerifyAgent — Evidence Verifier",
  "version": "0.1.0",
  "description": "One-click verification for AI-agent receipts and evidence. Evidence first, not endorsement.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.commandlayer.org/*",
    "https://commandlayer.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verify with VerifyAgent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["adapters.js", "content.js"]
    }
  ]
}
